# =============================================================================
# Airymax SDK TypeScript — .gitignore
# =============================================================================

# Node.js
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 构建产物
dist/
build/
out/
*.js
*.js.map
*.d.ts
!*.config.js

# TypeScript 缓存
*.tsbuildinfo

# 测试与覆盖率
coverage/
.nyc_output/
test-results/

# IDE 配置
.vscode/
.idea/
.vs/
*.code-workspace

# 环境与密钥
.env
.env.*
!.env.example
*.pem
*.key

# 操作系统
.DS_Store
Thumbs.db

# 编辑器临时文件
*.swp
*.swo
*~

# 日志与临时文件
*.log
*.tmp
*.bak

# ===== 通用兜底（2026-08 统一更新） =====
# 误放的大型运行时目录（JDK 等）与运行时产物
oracleJdk-*/
jdk-*/
*.log
*.sock
/run/
/logs/
